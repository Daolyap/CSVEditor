<?xml version="1.0" encoding="UTF-8"?>
<!--
    WiX Toolset configuration for CSV Editor MSI Installer
    
    This file defines the MSI installer for CSV Editor, including:
    - Application files installation
    - Start Menu shortcuts
    - Desktop shortcut (optional)
    - File association for .csv files
    - Uninstallation support
    
    To build the MSI:
    1. Build the application with PyInstaller first
    2. Run: wix build -o CSVEditor.msi Product.wxs
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <!-- Package definition -->
    <Package Name="CSV Editor"
             Manufacturer="CSVEditor"
             Version="1.0.0.0"
             UpgradeCode="12345678-1234-1234-1234-123456789012"
             Scope="perMachine"
             Language="1033"
             Codepage="1252">

        <!-- Upgrade handling for future versions -->
        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." 
                      AllowSameVersionUpgrades="yes"/>

        <!-- Embed cabinet for single-file MSI -->
        <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>

        <!-- Include default WiX UI -->
        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>

        <!-- License agreement -->
        <WixVariable Id="WixUILicenseRtf" Value="License.rtf"/>

        <!-- Application icon for Add/Remove Programs -->
        <Icon Id="CSVEditorIcon" SourceFile="dist\CSVEditor\resources\icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="CSVEditorIcon"/>
        <Property Id="ARPHELPLINK" Value="https://github.com/Daolyap/CSVEditor"/>

        <!-- Install directory structure -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="CSV Editor">
                <Directory Id="ResourcesFolder" Name="resources"/>
            </Directory>
        </StandardDirectory>

        <!-- Start Menu shortcuts directory -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="CSV Editor"/>
        </StandardDirectory>

        <!-- Desktop directory for optional shortcut -->
        <StandardDirectory Id="DesktopFolder"/>

        <!-- Main component group - Application files -->
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <!-- Main executable -->
            <Component Id="MainExecutable" Guid="*">
                <File Id="CSVEditorExe" 
                      Source="dist\CSVEditor\CSVEditor.exe" 
                      KeyPath="yes">
                    <!-- File association for .csv files -->
                    <Shortcut Id="DesktopShortcut"
                              Directory="DesktopFolder"
                              Name="CSV Editor"
                              Description="CSV Editor - A modern CSV file editor"
                              WorkingDirectory="INSTALLFOLDER"
                              Icon="CSVEditorIcon"
                              Advertise="yes"/>
                </File>
            </Component>

            <!-- Application icon in resources folder -->
            <Component Id="IconComponent" Guid="*" Directory="ResourcesFolder">
                <File Id="AppIcon" 
                      Source="dist\CSVEditor\resources\icon.ico" 
                      KeyPath="yes"/>
            </Component>
        </ComponentGroup>

        <!-- Component for Start Menu shortcuts -->
        <ComponentGroup Id="ShortcutsGroup" Directory="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="*">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="CSV Editor"
                          Description="CSV Editor - A modern CSV file editor"
                          Target="[INSTALLFOLDER]CSVEditor.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="CSVEditorIcon"/>
                
                <Shortcut Id="UninstallShortcut"
                          Name="Uninstall CSV Editor"
                          Description="Uninstall CSV Editor"
                          Target="[SystemFolder]msiexec.exe"
                          Arguments="/x [ProductCode]"/>

                <RemoveFolder Id="CleanUpShortcutsDir" On="uninstall"/>
                <RegistryValue Root="HKCU" 
                               Key="Software\CSVEditor\CSV Editor" 
                               Name="installed" 
                               Type="integer" 
                               Value="1" 
                               KeyPath="yes"/>
            </Component>
        </ComponentGroup>

        <!-- Component for file association -->
        <ComponentGroup Id="FileAssociationGroup" Directory="INSTALLFOLDER">
            <Component Id="CSVFileAssociation" Guid="*">
                <!-- Registry entries for .csv file association -->
                <RegistryValue Root="HKCR" 
                               Key=".csv\OpenWithProgids" 
                               Name="CSVEditor.csv" 
                               Type="string" 
                               Value="" 
                               KeyPath="yes"/>
                
                <RegistryValue Root="HKCR" 
                               Key="CSVEditor.csv" 
                               Type="string" 
                               Value="CSV File"/>
                
                <RegistryValue Root="HKCR" 
                               Key="CSVEditor.csv\DefaultIcon" 
                               Type="string" 
                               Value="[INSTALLFOLDER]resources\icon.ico"/>
                
                <RegistryValue Root="HKCR" 
                               Key="CSVEditor.csv\shell\open\command" 
                               Type="string" 
                               Value="&quot;[INSTALLFOLDER]CSVEditor.exe&quot; &quot;%1&quot;"/>
                
                <!-- Add to 'Open with' list -->
                <RegistryValue Root="HKLM" 
                               Key="Software\Classes\Applications\CSVEditor.exe\shell\open\command" 
                               Type="string" 
                               Value="&quot;[INSTALLFOLDER]CSVEditor.exe&quot; &quot;%1&quot;"/>
                
                <RegistryValue Root="HKLM" 
                               Key="Software\Classes\Applications\CSVEditor.exe\SupportedTypes" 
                               Name=".csv" 
                               Type="string" 
                               Value=""/>
                
                <!-- Friendly app name -->
                <RegistryValue Root="HKLM" 
                               Key="Software\Classes\Applications\CSVEditor.exe" 
                               Name="FriendlyAppName" 
                               Type="string" 
                               Value="CSV Editor"/>
            </Component>
        </ComponentGroup>

        <!-- Feature definition -->
        <Feature Id="ProductFeature" Title="CSV Editor" Level="1">
            <ComponentGroupRef Id="ProductComponents"/>
            <ComponentGroupRef Id="ShortcutsGroup"/>
            <ComponentGroupRef Id="FileAssociationGroup"/>
        </Feature>

    </Package>
</Wix>
